  (lib_symbols)
  (text "POWER / IPC-100 J10" (at 25.4 30 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom)) (uuid 10100000-0000-4000-8000-000000000002))
  (text "J1.1 EXPANSION_VCC (3.3 V protected) -> U1.21 VCC, C1.1, C2.1, R1.1, U1 unused GPIO pins\nJ1.2 GND -> U1.19 + exposed pad 25, C1.2, C2.2\nJ1.3 J10_I2C_SDA -> U1.22 SDA\nJ1.4 J10_I2C_SCL -> U1.23 SCL\nR1 10 k: +3V3 -> U1.20 RESET; U1.24 INT -> TP/INT_TEST only\nNo local SDA/SCL pull-ups: IPC-100 owns segment pull-ups/protection." (at 25.4 38 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid 10100000-0000-4000-8000-000000000003))
  (text "KEYPAD SCANNER — U1 TCA8418RTWR, 7-bit I2C address 0x34" (at 25.4 70 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom)) (uuid 10100000-0000-4000-8000-000000000004))
  (text "U1.8  ROW0 -> SW3 LEFT;    U1.7  ROW1 -> SW3 RIGHT\nU1.6  ROW2 -> SW3 UP;      U1.5  ROW3 -> SW3 DOWN\nU1.4  ROW4 -> SW3 CENTER;  U1.3  ROW5 -> SW1 START\nU1.2  ROW6 -> SW2 PULL;    U1.9  COL0 -> common of SW1/SW2/SW3\nU1.1 ROW7 and U1.10-.18 COL1-COL9 -> +3V3 (unused-input defined state)\nAll switches are normally open. TCA8418 internal keypad debounce and FIFO are used." (at 25.4 78 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid 10100000-0000-4000-8000-000000000005))
  (text "SAFETY STOP — ELECTRICALLY ISOLATED" (at 25.4 116 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom)) (uuid 10100000-0000-4000-8000-000000000006))
  (text "J3.1 STOP_IN_RAW -> SSTOP NC contact -> J3.2 STOP_RETURN -> IPC-100 J8A\nNo connection from either J3 net to logic GND, 3.3 V, U1, or copper pour.\nOpening the contact or harness asserts/faults STOP through IPC-100 hardware." (at 25.4 124 0) (effects (font (size 1.1 1.1) (bold yes)) (justify left top)) (uuid 10100000-0000-4000-8000-000000000007))
  (text "DISPLAY — MECHANICAL ONLY ON IPC-101" (at 25.4 148 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom)) (uuid 10100000-0000-4000-8000-000000000008))
  (text "DS1 Adafruit 938 SSD1306 module mounts on IPC-101 standoffs but connects directly to IPC-100 J6.\nJ6: OLED_VCC, GND, SDA, SCL; OLED_RESET insulated at module end pending received-revision check.\nThe OLED is not connected to J1/J10 or the keypad scanner nets." (at 25.4 156 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid 10100000-0000-4000-8000-000000000009))
  (text "NOTE: This human-reviewable connectivity capture is authoritative for P0 alongside the PCB net assignments.\nIt intentionally uses no unresolved library symbols. Re-capture with released project symbols and run native ERC before fabrication." (at 25.4 185 0) (effects (font (size 1.1 1.1) (italic yes)) (justify left top)) (uuid 10100000-0000-4000-8000-000000000010))
